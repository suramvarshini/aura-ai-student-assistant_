# ==========================================
# AI Student Assistant - Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Defaults to local MongoDB or automatically falls back to in-memory MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ai_student_assistant

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_min
SESSION_SECRET=replace_with_a_secure_session_secret_key

# Google OAuth 2.0 Credentials (for Google Sign-In & Google Classroom API)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Gemini API Key
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MCP (Model Context Protocol) Server Configuration
MCP_PORT=5001
MCP_ENDPOINT=/mcp
